# Mailchimp Configuration (Server-side only)
NUXT_MAILCHIMP_API_KEY=your-mailchimp-api-key
NUXT_MAILCHIMP_SERVER_PREFIX=us1
NUXT_MAILCHIMP_LIST_ID=your-list-id

# Altcha CAPTCHA Configuration (Server-side only)
# Must match the ALTCHA_HMAC_KEY in Apex Lambda environment
# Generate with: openssl rand -base64 32
NUXT_ALTCHA_HMAC_KEY=your-secure-random-hmac-key-here
